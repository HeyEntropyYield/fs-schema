# deny root, then allow known tree
/*
!/LICENSE
!/README.md
!/AGENTS.md
!/pyproject.toml
!/uv.lock
!/.python-version
!/.uv-version
!/run.sh
!/Dockerfile
!/.dockerignore
!/.gitignore
!/.pre-commit-config.yaml
!/.github/
!/scripts/
!/src/
!/tests/
!/zensical.toml
!/docs/

# generated (documented; /* already drops these at root)
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/
.venv/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.pytest-runtimes
.ruff_cache/
.mypy_cache/
.basedpyright/
site/
.cache/
*.whl
tmp/
