# deny root, then allow known tree
/*
!/.dockerignore
!/.gitignore
!/.pre-commit-config.yaml
!/.python-version
!/AGENTS.md
!/CHANGELOG.md
!/Dockerfile
!/LICENSE
!/README.md
!/pyproject.toml
!/run.sh
!/uv.lock
!/zensical.toml
!/.github/
!/docs/
!/examples/
!/scripts/
!/src/
!/tests/
!/versions/

# generated (documented; /* already drops these at root)
coverage.json
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/
.venv/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.pytest-runtimes
.ruff_cache/
.mypy_cache/
.basedpyright/
site/
.cache/
*.whl
tmp/
