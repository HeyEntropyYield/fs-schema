#!/usr/bin/env bash
set -euo pipefail

readonly VENV_BIN='.venv/bin'

_err(){ echo "$1" >&2; return 1; }

_find_venv_root(){
  local search_dir="$1"
  while [ "$search_dir" != / ] && [ ! -d "$search_dir/$VENV_BIN" ]; do
    search_dir=$(dirname "$search_dir")
  done
  [ -d "$search_dir/$VENV_BIN" ] || _err "beartype launcher: no .venv found" || return $?
  printf '%s\n' "$search_dir"
}

_relative_path(){
  case "$2" in
    "$1/"*) printf '%s\n' "${2#"$1"/}" ;;
    *) _err "beartype launcher: script not under project root" || return 1 ;;
  esac
}

_modulize_path(){ printf '%s' "$1" | sed 's#\.py$##; s#/#.#g'; }

main(){(
  [ "$#" -ne 0 ] || _err "usage: scripts/beartype SCRIPT [ARG ...]" || return $?
  local script root relative module
  script="$(readlink -f "$1")" || return $?
  root="$(_find_venv_root "$(dirname "$script")")" || return $?
  relative="$(_relative_path "$root" "$script")" || return $?
  module="$(_modulize_path "$relative")" || return $?
  export PATH="$root/$VENV_BIN:$PATH"
  cd "$root"
  exec python -c '
import importlib
import sys

module = importlib.import_module(sys.argv[1])
raise SystemExit(module.main(sys.argv[3:]))
' "$module" "$@"
)}

main "$@"
